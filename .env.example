# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres + PostGIS via docker_compose.yml) ---
POSTGRES_USER=redraw
POSTGRES_PASSWORD=redraw
POSTGRES_DB=redraw
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://redraw:redraw@localhost:5432/redraw
# For quick local dev without Postgres you can use SQLite instead:
# DATABASE_URL=sqlite:///data/processed/redraw.db

# --- Data pipeline ---
# Census API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# ACS 5-year vintage and LODES version used by fetch_census.py
ACS_YEAR=2022
LODES_VERSION=LODES8
LODES_YEAR=2021
# Planetary Computer subscription key is optional (anonymous access works for NAIP)
PC_SDN_KEY=

# --- AI residents (any OpenAI compatible endpoint, e.g. vLLM) ---
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_TIMEOUT_S=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Number of worker processes for plan runs (Monte Carlo seeds run in parallel)
SIM_WORKERS=4
# Seeds per report card
REPORT_SEEDS=20
# Where processed data lives (defaults to data/processed)
REDRAW_DATA_DIR=data/processed
# Where built client assets live (served by the API under /assets)
REDRAW_ASSETS_DIR=client/public/assets

# MongoDB Atlas instead of Postgres/SQLite (hosted API, deploy/hf-space/DEPLOY.md):
# DATABASE_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/redraw?retryWrites=true&w=majority
